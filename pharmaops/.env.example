# PharmaOps MVP environment variables
#
# The MVP runs in demo / mock mode by default. Supabase wiring is optional
# until you flip the demo flag off. Never commit a real .env file.

# --- Supabase (optional in MVP demo mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime mode ---
# When true, the app runs against the in-memory demo store (no Supabase calls).
# When false, the app expects valid NEXT_PUBLIC_SUPABASE_* values.
NEXT_PUBLIC_PHARMAOPS_DEMO_MODE=true

# --- Optional pharmacy branding (development only) ---
NEXT_PUBLIC_PHARMAOPS_DEFAULT_PHARMACY_NAME="Farmacia Demo Centro"

# --- OCR provider ---
# Pick the provider used by /documents → "Extraer datos".
# Allowed values: mock | azure | google | aws.
# When the requested provider is not configured (env vars / SDK / file
# storage missing), the app falls back to the mock provider and clearly
# labels the proposal as "Demo OCR" in the UI. Never expose real keys
# client-side: only OCR_PROVIDER is read in code paths that may run on the
# client, and even that is only used for the badge.
OCR_PROVIDER=mock

# Azure AI Document Intelligence (server-only). Leave blank to use mock.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
