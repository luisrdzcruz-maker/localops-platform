# PharmaOps MVP environment variables
#
# The MVP runs in demo / mock mode by default. Supabase wiring is optional
# until you flip the demo flag off. Never commit a real .env file. This file
# only ships placeholders.

# --- Runtime mode ---
# Canonical flag. Values: "demo" | "production_stub".
# "demo"            → in-memory deterministic store, no external services.
# "production_stub" → expects real services; the UI degrades to read-only
#                     messages until they are configured.
NEXT_PUBLIC_APP_MODE=demo

# Legacy flag, kept for backwards compatibility. Same effect as above:
# when "false" the runtime treats it as production_stub.
NEXT_PUBLIC_PHARMAOPS_DEMO_MODE=true

# Optional pharmacy branding for the local demo (development only).
NEXT_PUBLIC_PHARMAOPS_DEFAULT_PHARMACY_NAME="Farmacia Demo Centro"

# --- Supabase (future production) ---
# In demo mode these can stay empty. In production_stub mode the UI will
# clearly flag them as not connected until both URL and anon key are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OCR provider (future production) ---
# Pick the provider used by /documents → "Extraer datos".
# Allowed values: mock | azure | google | aws.
# When the requested provider is not configured (env vars / SDK / file
# storage missing), the app falls back to the mock provider and clearly
# labels the proposal as "Demo OCR" in the UI.
OCR_PROVIDER=mock

# Azure AI Document Intelligence (server-only). Leave blank to keep mock.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice

# --- AWS document storage / Textract (future production option) ---
# Used as the originals bucket and, optionally, as the OCR backend.
# AWS_TEXTRACT_ENABLED must be "true" for the runtime to consider Textract
# as the active OCR provider.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DOCUMENTS_BUCKET=
AWS_TEXTRACT_ENABLED=false
